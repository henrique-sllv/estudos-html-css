algoritmo "semnome"
var
 N1: INTEIRO
 RESU: CARACTERE
 // FUNÇÃO
 FUNCAO PAROUIMPAR ( V : INTEIRO) : CARACTERE
 VAR
 R : CARACTERE
 INICIO
  SE (N1 % 2 = 0) ENTAO
  RETORNE " É PAR"
  SENAO
  RETORNE  (" É INPAR ")
  FIMSE
  RETORNE R
 FIMFUNCAO
inicio
  ESCREVAL(" DIGITE  UM NUMERO")
  LEIA (N1)
  RESU <- PAROUIMPAR (N1)
  ESCREVAL ( N1,RESU)
fimalgoritmo

