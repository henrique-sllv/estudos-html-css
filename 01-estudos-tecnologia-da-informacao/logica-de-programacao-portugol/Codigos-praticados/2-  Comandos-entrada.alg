algoritmo " AULA 2"
var
 nome, ms1, ms2,ms3, ms4, ms5 : caractere

inicio
 escreval (" olá, bom dia")
 escreva (" qual o seu nome ??")
 leia(nome)
 escreval ("prazer ", nome, " meu nome é mariza, e essa é a nossa loja")
 leia (ms1)
 escreval(" temos todos os tipos de produtos, desde eletronicos a comidas ")
 leia (ms2)
 escreval(" sim, dividimos em ate 4x no cartão de crédito")
 leia (ms3)
 escreval (" certo! ele custa 2000R$, se vc parcelar em 4X fica ", 2000/4, " cada parcela")
 leia (ms4)
 escreval(" otimo, obrigado pela compra!!!!!")
 leia (ms5)
 escreva(" eu quem agradeço, volte sempre")
fimalgoritmo