algoritmo "AULA 3 PRATICA RICKYYY"
var
NOME1,NOME2: CARACTERE
CHARA,NORMAL, R1, R2, R3, R4,R5,R6:LOGICO
N1,N2,N3, N4, N5, N6,N7:inteiro
inicio
 ESCREVAl(" DIGITE UM NOME")
 LEIA (NOME1)
 ESCREVAl(" DIGITE OUTRO ")
 LEIA(NOME2)
 CHARA <- (NOME1 = NOME2 )
 NORMAL <- ( NOME1 <> NOME2)
 ESCREVAL(" ELES SÃO CHARÁ ???",CHARA)
 ESCREVAL (" ELES NÃO SÃO CHARÁ ???",NORMAL)
 ESCREVAL("-----------------------------------------------")
 ESCREVAL(" AQ OUTRO EXEMNPLO ")
 ESCREVAL(" VOU PERGUNTAR CONTAS BASICAS ")
 ESCREVAL(" ME DÊ DOIS NUMEROS Q JUNTOS FORMAM 7")
 LEIA (N1)
 ESCREVAL(" OUTRO")
 LEIA (N2)
 R1 <- ( N1 + N2 = 7)
 escreval(" correto ou errado???", R1)
 ESCREVAL("-----------------------------------------------")
 ESCREVAL(" A DIVISÃO DE 25 POR 5 É???")
 LEIA (N3)
 R2 <- ( 25/5= N3 )
 ESCREVAL(" CORRETO OU ERRADO ???", R2)
 ESCREVAL("--------------------------------------------------")
 ESCREVAL (" A MULTIPLICACAÇAO DE 3 X 5 É??")
 LEIA(N4)
 R3 <- ( 3 * 5 = N4 )
 ESCREVAL(R3)
 ESCREVAL("--------------------------------------------------")
 ESCREVAL(" QUANTO É 3 ELEVADO A 3 ???")
  LEIA (N5)
  R4<- ( 3^3 = N5 )
  ESCREVAL(R4)
  ESCREVAL("-------------------------------------------------")
  ESCREVAL (" QUANTO É 5 + 3 * 10???")
  LEIA (N6)
  R5 <- ( 5 + 3 ) * 10 = N6)
  ESCREVAL (R5)
  ESCREVAL ("---------------------------------------------")
  ESCREVAL(" E 8 MENOS 4 DIVIDIDO POR  2 MULTIPLICADO POR 2 E ELEVADO A 3???")
  LEIA (N7)
  R6 <- (((8-4)/2)*2) ^3= N7)
  ESCREVA (R6)
fimalgoritmo